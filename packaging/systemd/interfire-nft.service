# Restore InterFire-owned nftables table (manual recovery only).
# Package install does not enable this unit. Prefer `interfirectl resume` /
# UI Start after `interfired` has bound NFQUEUE with fail-open.
[Unit]
Description=InterFire owned nftables queue rule
Documentation=https://github.com/Interchouette-ITC/InterFire
DefaultDependencies=no
After=network-pre.target systemd-modules-load.service interfired.service
Before=network.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /usr/share/interfire/interfire.nft
ExecStop=-/usr/sbin/nft delete table inet interfire

[Install]
WantedBy=multi-user.target
